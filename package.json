{
  "name": "lightdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Unified DMX (Light Rider LR512) + Zigbee (Home Assistant) lighting control for Dreamscape",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/server/public && cp -r src/server/public dist/server/public",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "spider": "tsx src/cli/spider.ts",
    "laser": "tsx src/cli/laser.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
